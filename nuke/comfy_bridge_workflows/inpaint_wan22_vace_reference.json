 "_comfy_bridge": {
  "name": "Inpaint - Wan 2.2 VACE video (replace with a reference image)",
  "sequence": "temporal",
  "description": "Replaces what the mask covers with the object in the reference image, over the whole shot at once (Wan 2.2 Fun VACE A14B, high + low noise, lightx2v 4 steps). Comfy Cloud only. Plate and mask (white = replace) as in the other inpaint workflows; the reference goes into the aux input and is sent once, from the first frame of the range (a still of the object, ideally on a plain background). Describe the object in the prompt too. The reference is required: for plain removal use the LTX-2.5 video inpaint. Works best when the masked object is big in frame (a car, a person): a small hole gets few pixels at work size and the reference is lost. Works at 'work size' on the short side (480 is what the model was trained for; 720 is slower), result scaled back to the plate format. Up to 81 frames per run (about 3 s at 24 fps): split longer shots. Keep 'comp result over plate with mask' on.",
  "output": "color",
  "plate_node": "1",
  "mask_node": "2",
  "inputs": [
   {
    "node": "4",
    "label": "reference",
    "from": "aux",
    "layer": "rgba",
    "send": "color"
   }
  ],
  "match_format": true,
  "send_exposure": false,
  "sampler_params": false,
  "constraints": {
   "frames_rule": "8n+1",
   "max_frames": 81
  },
  "output_scale": 1,
  "params": [
   {
    "label": "prompt",
    "node": "20",
    "input": "text",
    "type": "text",
    "tooltip": "Describe the object that goes in the mask (e.g. 'a red vintage racing car')."
   },
   {
    "label": "negative",
    "node": "21",
    "input": "text",
    "type": "text"
   },
   {
    "label": "work size",
    "node": "30",
    "input": "resize_type.shorter_size",
    "type": "int",
    "min": 256,
    "max": 1080,
    "tooltip": "Short side in pixels (rounded to 16). 480 is the model's native size; 720 is slower."
   },
   {
    "label": "VACE strength",
    "node": "40",
    "input": "strength",
    "type": "float",
    "min": 0,
    "max": 2,
    "tooltip": "How strongly the plate around the mask and the reference steer the result (1 = default)."
   },
   {
    "label": "mask grow",
    "node": "36",
    "input": "value",
    "type": "int",
    "min": 0,
    "max": 64,
    "tooltip": "Extra dilation in ComfyUI, in work-size pixels."
   },
   {
    "label": "seed",
    "node": "41",
    "input": "noise_seed",
    "type": "int",
    "also": [
     [
      "42",
      "noise_seed"
     ]
    ]
   }
  ],
  "source": "Built for ComfyBridge from the Wan 2.2 Fun VACE inpaint recipe (core WanVaceToVideo, two-stage high / low noise sampling with the lightx2v 4-step LoRAs), after David's ER_Change_Car workflow (Kijai WanVideoWrapper + SAM3). The mask comes from Nuke, so SAM3 is left out."
 }
