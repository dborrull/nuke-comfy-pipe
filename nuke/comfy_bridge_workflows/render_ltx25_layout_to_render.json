{
  "_comfy_bridge": {
    "name": "Render - LTX-2.5 Layout to Render",
    "sequence": "temporal",
    "media": "video",
    "description": "Turns a layout / clay / blockout render into a photoreal shot that keeps its camera and layout (LTX-2.5 22B + Layout-to-Render IC-LoRA, Lightricks). Plate = the layout sequence. Aux = a look still (a frame you already made photoreal, e.g. with Render to photo): it gives textures, materials, light and palette. Two stages: generates at the sent size and refines at x2. Send it at working size 960 (set on load). Comfy Cloud only, up to 241 frames.",
    "output": "color",
    "plate_node": "1",
    "match_format": true,
    "work_size": 960,
    "send_exposure": false,
    "sampler_params": false,
    "constraints": {"frames_rule": "8n+1", "size_multiple": 32, "max_frames": 241},
    "output_scale": 2,
    "inputs": [
      {"node": "40", "label": "look still", "from": "aux", "send": "color"}
    ],
    "params": [
      {"label": "prompt", "node": "7", "input": "text", "type": "text",
       "tooltip": "Describe the final look: place, time of day, materials ('Wooden cabin in a pine forest at golden hour, photoreal cinematic render.')."},
      {"label": "negative", "node": "8", "input": "text", "type": "text"},
      {"label": "fps", "node": "9", "input": "frame_rate", "type": "float", "min": 1, "max": 60,
       "tooltip": "Frame rate of the layout."},
      {"label": "lora strength", "node": "3", "input": "strength_model", "type": "float", "min": 0, "max": 1.5},
      {"label": "look strength", "node": "14", "input": "strength", "type": "float", "min": 0, "max": 1,
       "also": [["32", "strength"]], "tooltip": "How much the look still drives the result."},
      {"label": "seed", "node": "15", "input": "noise_seed", "type": "int", "also": [["35", "noise_seed"]]},
      {"label": "model", "node": "2", "input": "unet_name", "type": "string"}
    ],
    "source": "ComfyBridge v0.10. Adapted from Lightricks LTX-2.5_ICLoRA_Layout_To_Render_Two_Stage_Distilled (API export): LoadVideo replaced by the ComfyBridge plate sequence, look still from aux, Gemma API switch removed."
  },
  "1": {"class_type": "LoadImage", "_meta": {"title": "layout (plate)"}, "inputs": {"image": "plate.png"}},
  "40": {"class_type": "LoadImage", "_meta": {"title": "look still (aux)"}, "inputs": {"image": "look.png"}},
  "2": {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "3": {"class_type": "LTXICLoRALoaderModelOnly", "inputs": {"model": ["2", 0], "lora_name": "ltx-2.5-22b-ic-lora-layout-to-render-1.0.safetensors", "strength_model": 1.0}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "video vae"}, "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "5": {"class_type": "LatentUpscaleModelLoader", "inputs": {"model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"}},
  "6": {"class_type": "CLIPLoader", "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "prompt"}, "inputs": {"clip": ["6", 0], "text": "Photoreal cinematic render."}},
  "8": {"class_type": "CLIPTextEncode", "_meta": {"title": "negative"}, "inputs": {"clip": ["6", 0], "text": ""}},
  "9": {"class_type": "LTXVConditioning", "inputs": {"positive": ["7", 0], "negative": ["8", 0], "frame_rate": 24.0}},
  "10": {"class_type": "GetImageSize", "inputs": {"image": ["1", 0]}},
  "11": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": ["10", 0], "height": ["10", 1], "length": ["10", 2], "batch_size": 1}},
  "13": {"class_type": "LTXAddVideoICLoRAGuide", "_meta": {"title": "layout guide"}, "inputs": {"positive": ["9", 0], "negative": ["9", 1], "vae": ["4", 0], "latent": ["11", 0], "image": ["1", 0],
         "frame_idx": 0, "strength": 1.0, "latent_downscale_factor": ["3", 1], "crop": "disabled",
         "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64, "use_streaming": false, "tile_frames": 97}},
  "14": {"class_type": "LTXAddVideoICLoRAGuide", "_meta": {"title": "look guide"}, "inputs": {"positive": ["13", 0], "negative": ["13", 1], "vae": ["4", 0], "latent": ["13", 2], "image": ["40", 0],
         "frame_idx": -1, "strength": 1.0, "latent_downscale_factor": ["3", 1], "crop": "center",
         "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64, "use_streaming": false, "tile_frames": 97}},
  "15": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
  "16": {"class_type": "CFGGuider", "inputs": {"model": ["3", 0], "positive": ["14", 0], "negative": ["14", 1], "cfg": 1.0}},
  "17": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "18": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "19": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "stage 1"}, "inputs": {"noise": ["15", 0], "guider": ["16", 0], "sampler": ["17", 0], "sigmas": ["18", 0], "latent_image": ["14", 2]}},
  "20": {"class_type": "LTXVCropGuides", "inputs": {"positive": ["14", 0], "negative": ["14", 1], "latent": ["19", 0]}},
  "30": {"class_type": "LTXVLatentUpsampler", "inputs": {"samples": ["20", 2], "upscale_model": ["5", 0], "vae": ["4", 0]}},
  "31": {"class_type": "LTXAddVideoICLoRAGuide", "_meta": {"title": "layout guide x2"}, "inputs": {"positive": ["9", 0], "negative": ["9", 1], "vae": ["4", 0], "latent": ["30", 0], "image": ["1", 0],
         "frame_idx": 0, "strength": 1.0, "latent_downscale_factor": 1, "crop": "disabled",
         "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64, "use_streaming": false, "tile_frames": 97}},
  "32": {"class_type": "LTXAddVideoICLoRAGuide", "_meta": {"title": "look guide x2"}, "inputs": {"positive": ["31", 0], "negative": ["31", 1], "vae": ["4", 0], "latent": ["31", 2], "image": ["40", 0],
         "frame_idx": -1, "strength": 1.0, "latent_downscale_factor": 1, "crop": "center",
         "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64, "use_streaming": false, "tile_frames": 97}},
  "33": {"class_type": "CFGGuider", "inputs": {"model": ["3", 0], "positive": ["32", 0], "negative": ["32", 1], "cfg": 1.0}},
  "34": {"class_type": "ManualSigmas", "inputs": {"sigmas": "0.909375, 0.725, 0.421875, 0.0"}},
  "35": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
  "36": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "stage 2"}, "inputs": {"noise": ["35", 0], "guider": ["33", 0], "sampler": ["17", 0], "sigmas": ["34", 0], "latent_image": ["32", 2]}},
  "37": {"class_type": "LTXVCropGuides", "inputs": {"positive": ["32", 0], "negative": ["32", 1], "latent": ["36", 0]}},
  "38": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["37", 2], "vae": ["4", 0], "tile_size": 512, "overlap": 64, "temporal_size": 128, "temporal_overlap": 32}},
  "39": {"class_type": "SaveImageAdvanced", "_meta": {"title": "output"}, "inputs": {"images": ["38", 0], "filename_prefix": "comfy_bridge", "format": "exr", "format.bit_depth": "16-bit float", "format.input_color_space": "sRGB"}}
}
