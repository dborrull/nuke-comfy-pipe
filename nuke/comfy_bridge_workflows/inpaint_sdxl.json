{
  "_comfy_bridge": {
    "name": "Inpaint - SDXL (mask)",
    "description": "Fill the masked area following the prompt (e.g. clean plate). Needs a mask (mask input or plate alpha). Result is comped over the plate inside the node.",
    "output": "color",
    "mask_node": "11",
    "params": [
      {
        "label": "prompt +",
        "node": "3",
        "input": "text",
        "type": "text",
        "tooltip": "Describe what should be there, not what to remove."
      },
      {
        "label": "prompt -",
        "node": "4",
        "input": "text",
        "type": "text"
      },
      {
        "label": "denoise",
        "node": "8",
        "input": "denoise",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "0.9-1.0 replaces the area. Pre-fill the hole in Nuke (clone/smear) and use 0.5-0.65 for best match."
      },
      {
        "label": "context padding (px)",
        "node": "13",
        "input": "padding",
        "type": "int",
        "tooltip": "Context around the mask, in plate pixels. More context = better match of texture scale and light."
      },
      {
        "label": "crop size",
        "node": "13",
        "input": "target_size",
        "type": "int",
        "tooltip": "Long edge the masked area is processed at."
      },
      {
        "label": "max scale",
        "node": "13",
        "input": "max_scale",
        "type": "float",
        "min": 0,
        "max": 4,
        "tooltip": "How much a small masked area may be enlarged. Lower = texture keeps the plate's scale (1-1.5); higher = more detail but the model may draw things too big."
      },
      {
        "label": "seed",
        "node": "8",
        "input": "seed",
        "type": "int"
      },
      {
        "label": "steps",
        "node": "8",
        "input": "steps",
        "type": "int"
      },
      {
        "label": "cfg",
        "node": "8",
        "input": "cfg",
        "type": "float",
        "min": 1,
        "max": 12
      },
      {
        "label": "checkpoint",
        "node": "2",
        "input": "ckpt_name",
        "options": [
          "epicrealismXL_vxviiCrystalclear.safetensors",
          "cyberrealisticXL_v70.safetensors",
          "sd_xl_base_1.0.safetensors"
        ]
      },
      {
        "label": "match color",
        "node": "15",
        "input": "match_color",
        "options": [
          "off",
          "on"
        ],
        "tooltip": "Match level and colour of the generated area to the untouched plate around the mask."
      },
      {
        "label": "match strength",
        "node": "15",
        "input": "match_strength",
        "type": "float",
        "min": 0,
        "max": 1
      }
    ]
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "plate.png"
    }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "mask.png"
    }
  },
  "12": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "channel": "red"
    }
  },
  "13": {
    "class_type": "ComfyBridgeCropToMask",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "mask": [
        "12",
        0
      ],
      "padding": 200,
      "target_size": 1024,
      "multiple": 8,
      "max_scale": 1.5
    }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "epicrealismXL_vxviiCrystalclear.safetensors"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        1
      ],
      "text": "dark dirty brick wall at night in shadow, small old bricks, grimy mortar, damp stains, photographic, film grain"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "2",
        1
      ],
      "text": "text, logo, sign, cable, person, object, cgi, 3d render, blurry, artifacts, seam"
    }
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "13",
        0
      ],
      "vae": [
        "2",
        2
      ]
    }
  },
  "14": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "mask": [
        "13",
        1
      ]
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "latent_image": [
        "14",
        0
      ],
      "seed": 1234,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.9
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "2",
        2
      ]
    }
  },
  "15": {
    "class_type": "ComfyBridgeStitch",
    "inputs": {
      "original": [
        "1",
        0
      ],
      "crop": [
        "9",
        0
      ],
      "crop_info": [
        "13",
        2
      ],
      "match_color": "off",
      "match_strength": 1.0
    }
  },
  "10": {
    "class_type": "ComfyBridgeSaveEXR",
    "inputs": {
      "images": [
        "15",
        0
      ],
      "filename_prefix": "comfy_bridge",
      "transfer": "data (as is)",
      "precision": "half"
    }
  }
}