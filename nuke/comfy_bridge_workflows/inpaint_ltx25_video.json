 "_comfy_bridge": {
  "name": "Inpaint - LTX-2.5 video (remove / replace)",
  "sequence": "temporal",
  "description": "Removes or replaces what the mask covers, over the whole shot at once, so the fill stays steady from frame to frame (LTX-2.5 22B + in/outpainting IC-LoRA, Lightricks; based on the Native HDR · Inpainting graph). Comfy Cloud only. Mask: white = replace (mask input or plate alpha; 'grow' and 'mask grow' widen it). Leave the prompt empty to remove, or describe what goes in the hole. Works at 'work size' on the short side (two passes: half size, then x2 refine), result scaled back to the plate format. Send the plate with input color sRGB (input: srgb_gamma): the result comes back scene-linear ACEScg (Read tagged ACEScg). The model also repaints a wide halo around the mask (about 150 px at 1080p): keep 'comp result over plate with mask' on so only the hole changes. Up to 241 frames.",
  "output": "color",
  "plate_node": "1",
  "mask_node": "2",
  "match_format": true,
  "send_exposure": false,
  "sampler_params": false,
  "constraints": {
   "frames_rule": "8n+1",
   "max_frames": 241
  },
  "output_scale": 1,
  "out_colorspace": "acescg",
  "params": [
   {
    "label": "prompt",
    "node": "20",
    "input": "text",
    "type": "text",
    "tooltip": "Empty: remove what the mask covers. Or describe what should be there."
   },
   {
    "label": "negative",
    "node": "21",
    "input": "text",
    "type": "text"
   },
   {
    "label": "input",
    "node": "4",
    "input": "color_space",
    "options": [
     "srgb_gamma",
     "srgb",
     "acescg",
     "acescct"
    ],
    "tooltip": "How the plate is encoded when it reaches ComfyUI. srgb_gamma: display sRGB (the PNG ComfyBridge sends with input color sRGB)."
   },
   {
    "label": "work size",
    "node": "30",
    "input": "resize_type.shorter_size",
    "type": "int",
    "min": 256,
    "max": 2048,
    "tooltip": "Short side of the result in pixels (rounded to 64). 1024 as in the original graph; 512-768 is faster and cheaper on Cloud."
   },
   {
    "label": "mask grow",
    "node": "35",
    "input": "value",
    "type": "int",
    "min": 0,
    "max": 100,
    "tooltip": "Extra dilation in ComfyUI, in work-size pixels (pass 2 uses twice this)."
   },
   {
    "label": "fps",
    "node": "22",
    "input": "frame_rate",
    "type": "float",
    "min": 1,
    "max": 60,
    "also": [
     [
      "43",
      "frame_rate"
     ]
    ]
   },
   {
    "label": "lora strength",
    "node": "11",
    "input": "strength_model",
    "type": "float",
    "min": 0,
    "max": 1.5
   },
   {
    "label": "seed",
    "node": "46",
    "input": "noise_seed",
    "type": "int"
   }
  ],
  "source": "Rebuilt in API format from the 'Native HDR · Inpainting' workflow (two passes, float32 VAE, ACEScct working space). The EXR / mask-video loaders became the plate and mask LoadImage; the image-to-video and Gemma prompt enhancer branches (off by default there) and the audio reference were left out."
 }
