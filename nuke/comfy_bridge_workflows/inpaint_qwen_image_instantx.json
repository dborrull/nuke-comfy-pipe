{
 "_comfy_bridge": {
  "name": "Inpaint - Qwen-Image InstantX (mask, Cloud)",
  "description": "Fill the masked area following the prompt: clean plates, remove or replace objects. Needs a mask (mask input or plate alpha; grow / soften it in the node). Runs on Comfy Cloud (core nodes only). Lightning LoRA: 4 steps, cfg 1 (set it to 0 and use 20 steps, cfg 2.5 for full quality). Qwen-Image: Apache 2.0.",
  "source": "Adapted from Comfy-Org workflow_templates: image_qwen_image_instantx_inpainting_controlnet (MIT). See THIRD_PARTY_NOTICES.md.",
  "output": "color",
  "plate_node": "71",
  "mask_node": "11",
  "send_exposure": false,
  "params": [
   {
    "label": "prompt +",
    "node": "6",
    "input": "text",
    "type": "text",
    "tooltip": "Describe what should be in the masked area, not what to remove."
   },
   {
    "label": "prompt -",
    "node": "7",
    "input": "text",
    "type": "text"
   },
   {
    "label": "inpaint strength",
    "node": "108",
    "input": "strength",
    "type": "float",
    "min": 0,
    "max": 2,
    "tooltip": "ControlNet strength: how much the surrounding plate drives the fill."
   },
   {
    "label": "lightning LoRA",
    "node": "80",
    "input": "strength_model",
    "type": "float",
    "min": 0,
    "max": 1,
    "tooltip": "1 = fast (4 steps, cfg 1). 0 = full model: 20 steps, cfg 2.5."
   },
   {
    "label": "work size",
    "node": "172",
    "input": "largest_size",
    "type": "int",
    "also": [
     [
      "13",
      "largest_size"
     ]
    ],
    "tooltip": "Long edge the plate and mask are processed at. Result is scaled back to the plate format."
   }
  ]
 },
