  },
  "8": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "4",
        0
      ],
      "text": "低分辨率，低画质，画面过饱和，蜡像感，过度光滑，过度锐化，HDR效果，画面具有AI感，插画，卡通，3D渲染，CG，人物，行人"
    }
  },
