  "_comfy_bridge": {
    "name": "Render to photo - Qwen-Image 2512 + depth, FAST (Lightning 4 steps)",
    "description": "Same as 'Render to photo' with the Qwen-Image 2512 Lightning LoRA: 4 steps, cfg 1, around 10x faster. Use it to explore looks and prompts; switch to the full version for the final if you need more detail.",
    "output": "color",
    "plate_node": "1",
    "inputs": [
      {
        "node": "2",
        "label": "depth",
        "from": "plate",
        "layer": "depth",
        "mono": true
      }
    ],
    "params": [
      {
        "label": "prompt",
        "node": "7",
        "input": "text",
        "type": "text",
        "tooltip": "Describe the scene as a photograph: place, materials, time of day, light. The depth keeps the layout."
      },
      {
        "label": "negative",
        "node": "8",
        "input": "text",
        "type": "text"
      },
      {
        "label": "denoise",
        "node": "12",
        "input": "denoise",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "How far from the input it may go. 0.6 keeps your render's look, 0.9 reinvents textures (geometry stays thanks to depth)."
      },
      {
        "label": "depth strength",
        "node": "10",
        "input": "strength",
        "type": "float",
        "min": 0,
        "max": 1.5
      },
      {
        "label": "depth end",
        "node": "10",
        "input": "end_percent",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "Stop following the depth earlier (0.7-0.8) to give the model freedom in the details."
      },
      {
        "label": "depth mode",
        "node": "2",
        "input": "mode",
        "options": [
          "depth: distance -> 1/z (disparity)",
          "depth: distance (normalize + invert)",
          "depth: Nuke 1/z (normalize)"
        ],
        "tooltip": "Blender / Arnold / most renderers: 'distance'. Nuke ScanlineRender: 'Nuke 1/z'."
      },
      {
        "label": "seed",
        "node": "12",
        "input": "seed",
        "type": "int"
      },
      {
        "label": "steps",
        "node": "12",
        "input": "steps",
        "type": "int",
        "tooltip": "4 with Lightning."
      },
      {
        "label": "cfg",
        "node": "12",
        "input": "cfg",
        "type": "float",
        "min": 1,
        "max": 8,
        "tooltip": "1 with Lightning (the negative prompt has no effect at cfg 1)."
      },
      {
        "label": "model",
        "node": "3",
        "input": "unet_name",
        "type": "string",
        "tooltip": "File in models/diffusion_models (fp8, or a GGUF with the GGUF loader workflow)."
      },
      {
        "label": "controlnet",
        "node": "9",
        "input": "control_net_name",
        "type": "string",
        "tooltip": "File in models/controlnet."
      },
      {
        "label": "Lightning LoRA",
        "node": "30",
        "input": "lora_name",
        "type": "string"
      },
      {
        "label": "Lightning strength",
        "node": "30",
        "input": "strength_model",
        "type": "float",
        "min": 0,
        "max": 1.5
      }
    ]
  },
  "30": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "3",
        0
      ],
