{
 "_comfy_bridge": {
  "name": "Render to photo - Z-Image Turbo + ControlNet Union (depth / canny)",
  "description": "Generates a new photo that follows a control image. Default: the aux input is the control - a grey depth (near = white, 0-1, e.g. Blender depth normalised or a Depth Anything result), a pose or a line drawing. 'edges from plate' on: canny edges of the plate instead (aux not needed). Very fast (8 steps). Apache 2.0 models: fine for commercial work.",
  "source": "Adapted from Comfy-Org workflow_templates: image_z_image_turbo_fun_union_controlnet (MIT). See THIRD_PARTY_NOTICES.md.",
  "output": "color",
  "plate_node": "58",
  "params": [
   {
    "label": "prompt",
    "node": "45",
    "input": "text",
    "type": "text"
   },
   {
    "label": "edges from plate",
    "node": "71",
    "input": "switch",
    "type": "bool",
    "tooltip": "Off (default): the aux input drives the image (depth, pose, lines). On: canny edges of the plate."
   },
   {
    "label": "control strength",
    "node": "60",
    "input": "strength",
    "type": "float",
    "min": 0,
    "max": 2
   },
   {
    "label": "canny low",
    "node": "57",
    "input": "low_threshold",
    "type": "float",
    "min": 0.01,
    "max": 0.99
   },
   {
    "label": "canny high",
    "node": "57",
    "input": "high_threshold",
    "type": "float",
    "min": 0.01,
    "max": 0.99
   },
   {
    "label": "work size",
    "node": "62",
    "input": "largest_size",
    "type": "int",
    "tooltip": "Long edge the image is generated at (multiple of 16). The result is scaled back to the plate format.",
    "also": [
     [
      "73",
      "largest_size"
     ]
    ]
   }
  ],
  "inputs": [
   {
    "node": "72",
    "label": "control (depth grey near = white / pose / lines)",
    "from": "aux",
    "layer": "rgba",
    "send": "data"
   }
  ],
  "send_exposure": false
 },
 "58": {
  "class_type": "LoadImage",
