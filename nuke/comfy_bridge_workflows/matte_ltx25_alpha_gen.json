{
  "_comfy_bridge": {
    "name": "Matte - LTX-2.5 Alpha-Gen",
    "sequence": "temporal",
    "description": "Alpha matte of the main subject for the whole shot, without a green screen (LTX-2.5 22B + Alpha-Gen IC-LoRA 0.9, Lightricks). Comfy Cloud only. Mode must be sequence: the range goes in one job (padded to 8n+1 frames and to multiples of 32 px, undone on return). Result: the matte as grey RGB (data); shuffle it into alpha. Up to 241 frames.",
    "output": "data",
    "plate_node": "1",
    "match_format": true,
    "send_exposure": false,
    "sampler_params": false,
    "constraints": {"frames_rule": "8n+1", "size_multiple": 32, "max_frames": 241},
    "output_scale": 1,
    "params": [
      {"label": "prompt", "node": "7", "input": "text", "type": "text",
       "tooltip": "Optional. Usually empty; you can name the subject to keep (e.g. 'the woman in the red coat')."},
      {"label": "fps", "node": "9", "input": "frame_rate", "type": "float", "min": 1, "max": 120,
       "also": [["12", "frame_rate"]], "tooltip": "Frame rate of the plate."},
      {"label": "lora strength", "node": "3", "input": "strength_model", "type": "float", "min": 0, "max": 1.5,
       "tooltip": "Strength of the Alpha-Gen IC-LoRA."},
      {"label": "seed", "node": "15", "input": "noise_seed", "type": "int"},
      {"label": "model", "node": "2", "input": "unet_name", "type": "string"},
      {"label": "ic-lora", "node": "3", "input": "lora_name", "type": "string"}
    ],
    "source": "ComfyBridge v0.10. Rebuilt in API format from the LTX-2.5 Alpha Generation workflow (8-step distilled sampler, IC-LoRA video guide)."
  },
  "1": {"class_type": "LoadImage", "_meta": {"title": "plate"}, "inputs": {"image": "plate.png"}},
  "2": {"class_type": "UNETLoader", "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "3": {"class_type": "LTXICLoRALoaderModelOnly", "inputs": {"model": ["2", 0], "lora_name": "ltx-2.5-22b-ic-lora-alpha-gen-0.9.safetensors", "strength_model": 1.0}},
  "4": {"class_type": "VAELoader", "_meta": {"title": "video vae"}, "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "5": {"class_type": "VAELoader", "_meta": {"title": "audio vae"}, "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}},
  "6": {"class_type": "CLIPLoader", "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "7": {"class_type": "CLIPTextEncode", "_meta": {"title": "prompt"}, "inputs": {"clip": ["6", 0], "text": ""}},
  "8": {"class_type": "CLIPTextEncode", "_meta": {"title": "negative"}, "inputs": {"clip": ["6", 0], "text": ""}},
  "9": {"class_type": "LTXVConditioning", "inputs": {"positive": ["7", 0], "negative": ["8", 0], "frame_rate": 24.0}},
  "10": {"class_type": "GetImageSize", "inputs": {"image": ["1", 0]}},
  "11": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": ["10", 0], "height": ["10", 1], "length": ["10", 2], "batch_size": 1}},
  "12": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"frames_number": ["10", 2], "frame_rate": 24, "batch_size": 1, "audio_vae": ["5", 0]}},
  "13": {"class_type": "LTXAddVideoICLoRAGuide", "inputs": {"positive": ["9", 0], "negative": ["9", 1], "vae": ["4", 0], "latent": ["11", 0], "image": ["1", 0],
         "frame_idx": 0, "strength": 1.0, "latent_downscale_factor": ["3", 1], "crop": "disabled",
         "use_tiled_encode": false, "tile_size": 256, "tile_overlap": 64}},
  "14": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["13", 2], "audio_latent": ["12", 0]}},
  "15": {"class_type": "RandomNoise", "inputs": {"noise_seed": 42}},
  "16": {"class_type": "CFGGuider", "inputs": {"model": ["3", 0], "positive": ["13", 0], "negative": ["13", 1], "cfg": 1.0}},
  "17": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "18": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "19": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["15", 0], "guider": ["16", 0], "sampler": ["17", 0], "sigmas": ["18", 0], "latent_image": ["14", 0]}},
  "20": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["19", 0]}},
  "21": {"class_type": "LTXVCropGuides", "inputs": {"positive": ["13", 0], "negative": ["13", 1], "latent": ["20", 0]}},
  "22": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["21", 2], "vae": ["4", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}},
  "23": {"class_type": "SaveImageAdvanced", "_meta": {"title": "output"}, "inputs": {"images": ["22", 0], "filename_prefix": "comfy_bridge", "format": "exr", "format.bit_depth": "32-bit float", "format.input_color_space": "linear"}}
}
