  "_comfy_bridge": {
    "name": "Mix passes + inpaint - Qwen-Image 2512 + depth",
    "description": "Combines two passes and regenerates areas with a colour mask (mask input, sent as RGBA): GREEN = take the aux pass there, RED = regenerate there (e.g. walls), following the depth. Plate = pass A, aux input = pass B, depth from a layer of the plate.",
    "output": "color",
    "plate_node": "1",
    "mask_node": "4",
    "mask_channels": "rgba",
    "inputs": [
      {
        "node": "2",
        "label": "pass B",
        "from": "aux",
        "layer": "rgba",
        "send": "color",
        "match_exposure": true
      },
      {
        "node": "3",
        "label": "depth",
        "from": "plate",
        "layer": "depth",
        "mono": true
      }
    ],
    "params": [
      {
        "label": "prompt",
        "node": "20",
        "input": "text",
        "type": "text",
        "tooltip": "Describe the scene as a photograph: place, materials, time of day, light. The depth keeps the layout."
      },
      {
        "label": "negative",
        "node": "21",
        "input": "text",
        "type": "text"
      },
      {
        "label": "denoise",
        "node": "26",
        "input": "denoise",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "Denoise inside the red areas only."
      },
      {
        "label": "depth strength",
        "node": "23",
        "input": "strength",
        "type": "float",
        "min": 0,
        "max": 1.5
      },
      {
        "label": "depth end",
        "node": "23",
        "input": "end_percent",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "Stop following the depth earlier (0.7-0.8) to give the model freedom in the details."
      },
      {
        "label": "depth mode",
        "node": "3",
        "input": "mode",
        "options": [
          "depth: distance -> 1/z (disparity)",
          "depth: distance (normalize + invert)",
          "depth: Nuke 1/z (normalize)"
        ],
        "tooltip": "Blender / Arnold / most renderers: 'distance'. Nuke ScanlineRender: 'Nuke 1/z'."
      },
      {
        "label": "seed",
        "node": "26",
        "input": "seed",
        "type": "int"
      },
      {
        "label": "steps",
        "node": "26",
        "input": "steps",
        "type": "int"
      },
      {
        "label": "cfg",
        "node": "26",
        "input": "cfg",
        "type": "float",
        "min": 1,
        "max": 8
      },
      {
        "label": "model",
        "node": "16",
        "input": "unet_name",
        "type": "string",
        "tooltip": "File in models/diffusion_models (fp8, or a GGUF with the GGUF loader workflow)."
      },
      {
        "label": "controlnet",
        "node": "22",
        "input": "control_net_name",
        "type": "string",
        "tooltip": "File in models/controlnet."
      },
      {
        "label": "red grow (px)",
        "node": "12",
        "input": "expand",
        "type": "int"
      },
      {
        "label": "green grow (px)",
        "node": "7",
        "input": "expand",
        "type": "int"
      }
    ]
  }
