  "_comfy_bridge": {
    "name": "Depth to photo - style reference (Qwen-Image-Edit 2509)",
    "description": "Builds a new photo from the render's depth only (image 1) in the style of a reference image (image 2, aux input). The model never sees the render, so it cannot copy its CG look: geometry comes from the depth, everything else from the reference and the prompt. Describe the room and the light in the prompt.",
    "output": "color",
    "plate_node": "1",
    "inputs": [
      {
        "node": "2",
        "label": "style reference",
        "from": "aux",
        "layer": "rgba",
        "send": "color"
      },
      {
        "node": "3",
        "label": "depth",
        "from": "plate",
        "layer": "depth",
        "mono": true
      }
    ],
    "params": [
      {
        "label": "instruction",
        "node": "5",
        "input": "prompt",
        "type": "text",
        "tooltip": "Image 1 = depth map of your render, image 2 = style reference. Describe the room and light."
      },
      {
        "label": "denoise",
        "node": "8",
        "input": "denoise",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "1.0 = full reinterpretation (layout still kept by image 1 and depth). Lower keeps more of the render."
      },
      {
        "label": "depth mode",
        "node": "3",
        "input": "mode",
        "options": [
          "depth: distance -> 1/z (disparity)",
          "depth: distance (normalize + invert)",
          "depth: Nuke 1/z (normalize)"
        ]
      },
      {
        "label": "seed",
        "node": "8",
        "input": "seed",
        "type": "int"
      },
      {
        "label": "steps",
        "node": "8",
        "input": "steps",
        "type": "int",
        "tooltip": "4 with the Lightning LoRA, 20+ without."
      },
      {
        "label": "cfg",
