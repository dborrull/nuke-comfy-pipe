{
  "_comfy_bridge": {
    "name": "Edit - Qwen-Image-Edit 2509 (mask)",
    "description": "Edit the masked area with an instruction (add, remove, replace). The masked area is tinted red for the model: refer to it as 'the red area'. SAM3 mattes the object you name and it comes back as alpha (grade it in Nuke). Apache 2.0. Lightning LoRA: 4 steps, cfg 1.",
    "output": "color",
    "mask_node": "11",
    "params": [
      {
        "label": "instruction",
        "node": "3",
        "input": "prompt",
        "type": "text",
        "tooltip": "Refer to the mask as 'the red area': 'In the red area, add an old bicycle...'. Ask it to remove the red tint."
      },
      {
        "label": "mark strength",
        "node": "16",
        "input": "strength",
        "type": "float",
        "min": 0,
        "max": 1,
        "tooltip": "How strongly the masked area is tinted red for the model (0 = no hint)."
      },
      {
        "label": "matte object (SAM3)",
        "node": "17",
        "input": "prompt",
        "type": "string",
        "tooltip": "What to matte in the result for the alpha channel: 'bicycle', 'person', 'lamp'..."
      },
      {
        "label": "matte confidence",
        "node": "17",
        "input": "confidence_threshold",
        "type": "float",
        "min": 0.05,
        "max": 0.95
      },
      {
        "label": "context padding (px)",
        "node": "13",
        "input": "padding",
        "type": "int",
        "tooltip": "Context around the mask, in plate pixels. More context = better match of texture scale and light."
      },
      {
        "label": "crop size",
        "node": "13",
        "input": "target_size",
        "type": "int"
      },
      {
        "label": "max scale",
        "node": "13",
        "input": "max_scale",
        "type": "float",
        "min": 0,
        "max": 4,
        "tooltip": "How much a small masked area may be enlarged. Lower = texture keeps the plate's scale (1-1.5); higher = more detail but the model may draw things too big."
      },
      {
        "label": "seed",
        "node": "8",
        "input": "seed",
        "type": "int"
      },
      {
        "label": "steps",
        "node": "8",
        "input": "steps",
        "type": "int",
        "tooltip": "4 with the Lightning LoRA."
      },
      {
        "label": "Lightning LoRA strength",
        "node": "21",
        "input": "strength_model",
        "type": "float",
        "min": 0,
        "max": 1.5
      },
      {
        "label": "match color",
        "node": "15",
        "input": "match_color",
        "options": [
          "off",
          "on"
        ],
        "tooltip": "Match level and colour of the generated area to the untouched plate around the mask."
      },
      {
        "label": "match strength",
        "node": "15",
        "input": "match_strength",
        "type": "float",
        "min": 0,
        "max": 1
      }
    ],
    "matte": true
  },
